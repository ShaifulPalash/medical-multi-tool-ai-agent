# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real ".env" file to GitHub — only this example file.

# --- LLM (required) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Web search tool (optional) ---
# Get a free key at https://app.tavily.com (1000 free searches/month).
# If left blank, MedicalWebSearchTool automatically falls back to
# DuckDuckGo, which needs NO API key at all.
TAVILY_API_KEY=

# --- Kaggle credentials ---
# NOTE: Kaggle authentication normally works via a kaggle.json file placed
# at ~/.kaggle/kaggle.json (see README "Kaggle setup" section), NOT via
# environment variables in most setups — but the kaggle package also
# accepts these two env vars as an alternative if you'd rather not create
# the file. Only fill these in if you're using the env-var method.
KAGGLE_USERNAME=
KAGGLE_KEY=
